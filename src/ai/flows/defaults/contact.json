{
  "key": "contact",
  "name": "Talk to us",
  "entry": "q1",
  "triggers": {
    "chips": ["Talk to us", "Contact our team", "Talk to an expert"],
    "keywords": ["talk to someone", "talk to a person", "contact you", "contact your team", "speak to an agent", "send a message", "get in touch"],
    "greeting": { "show": true, "emoji": "💬", "label": "Talk to us", "order": 5 }
  },
  "nodes": [
    { "id": "q1", "type": "message", "data": { "text": "Happy to help! I'll pass your message to our travel team — they reply by email, usually within a few hours." } },
    { "id": "q2", "type": "input", "data": { "text": "What's your name?", "var": "name" } },
    { "id": "q3", "type": "input", "data": { "text": "And your email address, so we can reply?", "var": "email", "validate": "email", "invalidText": "That email doesn't look right — could you check it?" } },
    { "id": "q4", "type": "input", "data": { "text": "What would you like to ask? Add your dates and island if it's about a trip.", "var": "message", "acceptQuestions": true } },
    { "id": "q5", "type": "query", "data": { "subject": "From the website assistant", "name": "{{name}}", "email": "{{email}}", "message": "{{message}}", "category": "general" } },
    { "id": "q6", "type": "message", "data": { "text": "Thanks, {{name}}! Your message is with our team (reference #{{queryId}}). We'll reply to {{email}}." } },
    { "id": "q7", "type": "message", "data": { "text": "Sorry — your message couldn't be sent just now. Please try again in a moment." } },
    { "id": "end", "type": "end" }
  ],
  "edges": [
    { "from": "q1", "to": "q2" },
    { "from": "q2", "port": "ok", "to": "q3" },
    { "from": "q3", "port": "ok", "to": "q4" },
    { "from": "q3", "port": "invalid", "to": "q3" },
    { "from": "q4", "port": "ok", "to": "q5" },
    { "from": "q5", "port": "ok", "to": "q6" },
    { "from": "q5", "port": "error", "to": "q7" },
    { "from": "q6", "to": "end" },
    { "from": "q7", "to": "end" }
  ]
}
