# ── AI assistant (docs/rag-system/DESIGN.md §7) ─────────────────────────────
# NVIDIA LLM (OpenAI-compatible). Server only; never sent to the browser.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Vector database: mysql (built in, default) | pinecone (when credentials are set)
RAG_VECTOR_DRIVER=mysql
# Models (AI Settings in the admin overrides these). Fallbacks: comma-separated, tried in order.
RAG_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
RAG_CHAT_FALLBACK_MODELS=openai/gpt-oss-20b,nvidia/nemotron-3.5-lightning-30b-a3b,deepseek-ai/deepseek-v4.1-flash
RAG_EMBED_MODEL=nvidia/nemotron-3-embed-1b
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_INDEX_HOST=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=holidays-seychelles
# 32-byte key (base64) used to encrypt secrets saved from the admin panel.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RAG_SECRET_KEY=
RAG_STORAGE_DIR=storage/rag
RAG_MAX_UPLOAD_MB=20
CHAT_RETENTION_DAYS=90
CHAT_ENABLED=true
